<!-- src/main/resources/META-INF/plugin.xml -->

<idea-plugin>
    <id>com.example.plugin-test</id>

    <name>Code Visualizer</name>

    <vendor>Plugin Test</vendor>

    <description><![CDATA[
        Visualize how your application works directly inside IntelliJ IDEA.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">

        <!-- Settings | Tools | Nexus: the OpenAI key and model used by the Activity tab. -->
        <applicationConfigurable
                parentId="tools"
                id="com.example.activity.settings"
                displayName="Nexus"
                instance="com.example.activity.ActivityConfigurable"/>

        <!-- One window, one button on the stripe, a tab per view inside. The factory
             delegates to MyToolWindowFactory for the Map tab, so that file stays owned
             by the rest of the team and is not edited by this work. -->
        <toolWindow
                id="Nexus"
                anchor="right"
                factoryClass="com.example.yasinreel.render.NexusToolWindowFactory"
                icon="AllIcons.Toolwindows.ToolWindowPalette"/>

        <!-- Export balloons. ReelExporter builds a Notification directly when this is
             missing, but then the user cannot turn them down in Settings. -->
        <notificationGroup id="Nexus Reel" displayType="BALLOON"/>

        <!-- Trust light: the reading for the file in front of you, and the switch for the
             paint. Everything it needs lives under com.example.trust, so this feature adds
             files rather than editing anyone else's. -->
        <statusBarWidgetFactory
                id="com.example.trust.widget"
                implementation="com.example.trust.TrustWidgetFactory"
                order="before positionWidget"/>

    </extensions>

    <projectListeners>
        <!-- Repaints the wash when a file is opened or brought to the front. Stateless, as
             declarative listeners must be: the state is in the TrustService. -->
        <listener
                class="com.example.trust.TrustEditorListener"
                topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <actions>
        <action
                id="com.example.trust.toggle"
                class="com.example.trust.TrustToggleAction"
                text="Show Code That Has Never Run"
                description="Paint the lines in this project that no run has ever executed">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

</idea-plugin>